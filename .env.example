# Copy to .env and run `docker compose up` (see docker-compose.yml).
#
# DATABASE_URL and REDIS_URL are deliberately NOT listed here: the compose
# file points the backend container at the postgres/redis containers
# directly via its `environment` block, which overrides whatever is in this
# file for those two keys. This file only needs the remaining backend env
# vars — see backend/.env.example for the full reference and explanations
# of each one (same vars, same meanings, just for the non-Docker dev flow).

NETWORK_PASSPHRASE=Test SDF Network ; September 2015
CORS_ORIGIN=http://localhost:3000,exp://localhost:8081
JWT_SECRET=change_me_in_production
API_KEY=change_me_in_production

# Multiple containers could be scaled behind this compose file, so default
# to the shared Redis-backed lock rather than "in-process" (see
# backend/docs/concurrency.md).
LOCK_BACKEND=redis

SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
GLOBE_WALLET_CONTRACT_ID=CBGLPMNSM4FWMIZ6FFBSRN7FNVCHCI2SLZNODA27LEOXFPLWNYEAEP3K

# No reverse proxy in front of `docker compose up` locally.
TRUST_PROXY_HOPS=0
